-- Botão 1: INVOCAR PROPS
ActionButton1.MouseButton1Click:Connect(function()
    task.spawn(function()
        local args1 = {"PickingTools", "PropMaker"}
        game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1Too1l"):InvokeServer(unpack(args1))
        task.wait(0.4)

        local backpack = LocalPlayer:WaitForChild("Backpack")
        local propMakerTool = backpack:FindFirstChild("PropMaker")

        if propMakerTool then
            propMakerTool.Parent = LocalPlayer.Character
            task.wait(0.3) 
        else
            propMakerTool = LocalPlayer.Character:FindFirstChild("PropMaker")
            if not propMakerTool then return end
        end

        local toolPropMake = propMakerTool:WaitForChild("Tool_PropMake", 5)
        if not toolPropMake then return end

        local target_base = workspace:FindFirstChild("Baseplate") or workspace.Terrain
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local totalProps = 20
        local basePos = hrp.Position + Vector3.new(0, -3, 0)

        for i = 1, totalProps do
            local angle = (i / totalProps) * (math.pi * 2)
            local radius = (i % 2 == 0) and 14 or 24
            local pontoExclusivo = basePos + Vector3.new(math.sin(angle) * radius, 0, math.cos(angle) * radius)

            pcall(function()
                toolPropMake:FireServer(target_base, pontoExclusivo)
            end)
            task.wait(1.2)
        end
        print("Invocação Concluída com sucesso em cadência segura!")
    end)
end)

