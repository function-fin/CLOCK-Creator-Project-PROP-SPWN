-- Função Local para obter e contar a tabela de Props atuais do jogador
local function getMyProps()
    local PropFolder = workspace:FindFirstChild("WorkspaceCom") and workspace.WorkspaceCom:FindFirstChild("001_TrafficCones")
    if not PropFolder then return {} end
    local props = {}
    for _, child in ipairs(PropFolder:GetChildren()) do
        if child.Name:find(LocalPlayer.Name, 1, true) and child:FindFirstChild("SetCurrentCFrame") then
            table.insert(props, child)
        end
    end
    return props
end

-- Função Core de Ataque a um Jogador
local function AtacarAlvo(alvo)
    local currentProps = getMyProps()
    if #currentProps == 0 then return end

    if prisonThread then coroutine.close(prisonThread) end 

    prisonTarget = alvo
    prisonActive = true

    local propRemotes = {}
    for i = 1, #currentProps do
        local prop = currentProps[i]
        if prop then
            local remote = prop:FindFirstChild("SetCurrentCFrame")
            if remote then table.insert(propRemotes, remote) end
        end
    end

    local offsets = {}
    for i = 1, #propRemotes do
        offsets[i] = Vector3.new(math.sin(i) * 2, (i % 5) - 2, math.cos(i) * 2)
    end

    prisonThread = task.spawn(function()
        while prisonActive and prisonTarget and prisonTarget.Parent do
            local targetChar = prisonTarget.Character
            if targetChar then
                local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
                local torso = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("HumanoidRootPart")

                if torso and humanoid and humanoid.Health > 0 then
                    for i, remote in ipairs(propRemotes) do
                        local offset = offsets[i] or Vector3.new(0, 0, 0)
                        pcall(function()
                            remote:InvokeServer(CFrame.new(torso.Position + offset))
                        end)
                    end
                end
            end
            task.wait()
        end
        prisonThread = nil
    end)
end

local function AdicionarJogadorNaLista(player)
    if player == LocalPlayer or PlayerListFrame:FindFirstChild(player.Name) then return end
    local PlayerCard = Create("TextButton", PlayerListFrame, { Name = player.Name, Size = UDim2.new(1, -6, 0, 35), BackgroundColor3 = Color3.fromRGB(0, 0, 0), Text = "", ZIndex = 4 }, 4, { Color = Color3.fromRGB(60, 60, 60), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })

    Create("TextLabel", PlayerCard, { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.new(0, 6, 0, 3), BackgroundTransparency = 1, Text = player.DisplayName, TextColor3 = Color3.fromRGB(255, 255, 255), Font = FONTE_PROJETO, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5 })
    Create("TextLabel", PlayerCard, { Size = UDim2.new(1, -8, 0, 12), Position = UDim2.new(0, 6, 0, 18), BackgroundTransparency = 1, Text = "@" .. player.Name, TextColor3 = Color3.fromRGB(140, 140, 140), Font = FONTE_PROJETO, TextSize = 8, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5 })

    PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 6)

    PlayerCard.MouseButton1Click:Connect(function() 
        if JogadorSelecionado == player then
            ResetarAtaqueCompleto()
            DetalharSelecao()
        else
            JogadorSelecionado = player 
            DetalharSelecao()
            if prisonActive then
                prisonTarget = player
            end
        end
    end)
end

local function RemoverJogadorDaLista(player)
    local card = PlayerListFrame:FindFirstChild(player.Name)
    if card then
        if JogadorSelecionado == player then ResetarAtaqueCompleto() end
        card:Destroy() PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 6)
    end
end

for _, p in ipairs(Players:GetPlayers()) do AdicionarJogadorNaLista(p) end
Players.PlayerAdded:Connect(AdicionarJogadorNaLista)
Players.PlayerRemoving:Connect(RemoverJogadorDaLista)

-- Lógica do Botão ALL ON / ALL OFF
AllButton.MouseButton1Click:Connect(function()
    allActive = not allActive

    if allActive then
        AllButton.Text = "ALL\nON"
        
        allThread = task.spawn(function()
            while allActive do
                local listaJogadores = {}
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        table.insert(listaJogadores, player)
                    end
                end

                if #listaJogadores == 0 then
                    task.wait(1)
                else
                    for _, player in ipairs(listaJogadores) do
                        if not allActive then break end
                        
                        -- Define visual e ataca
                        JogadorSelecionado = player
                        DetalharSelecao()
                        AtacarAlvo(player)
                        
                        -- Mantém atacando este jogador por 10 segundos
                        local tempoDecorrido = 0
                        while tempoDecorrido < 10 and allActive and player.Parent do
                            task.wait(0.5)
                            tempoDecorrido = tempoDecorrido + 0.5
                        end
                    end
                end
            end
        end)
    else
        AllButton.Text = "ALL\nOFF"
        ResetarAllLoop()
        DetalharSelecao()
    end
end)

